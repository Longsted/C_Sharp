

@model Person[]
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <title>title</title>
</head>
<body>
<div>
    <ul>
        
        @foreach (var person in Model)
        {
            <li>
                @Html.Raw(GetFullName(person)) <!--lavet for at få lavet mellemrum -->
            </li>
        }

    </ul>
    
    @functions
    {
        public string GetFullName(Person p)
        {
            return $"{p.FirstName} {p.LastName}() <br/>{p.Adress}<br/>{p.Zip} {p.City}";
        }}
    
</div>

