@model musicstore.Models.MusicCD;

@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <title>title</title>
</head>
<body>
<div>
    @if (Model is MusicCD cd)
    {
        <h3>tracks </h3>
        @foreach (var p in cd.TrackList)
        {
            <li>@p </li>
        }
        
        <p>@cd.GetPlayingTime() </p>
    }
    

</div>
</body>
</html>