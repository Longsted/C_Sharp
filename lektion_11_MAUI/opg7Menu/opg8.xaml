<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="opg7Menu.opg8">

    <Grid Padding="20"
          RowDefinitions="*,*"
          ColumnDefinitions="*,*">

        <!-- RadioButtons -->
        <VerticalStackLayout Grid.Row="0" Grid.Column="0">
            <RadioButton Content="North" CheckedChanged="RadioButton_OnCheckedChanged"/>
            <RadioButton Content="South" CheckedChanged="RadioButton_OnCheckedChanged"/>
            <RadioButton Content="East" CheckedChanged="RadioButton_OnCheckedChanged"/>
            <RadioButton Content="West" CheckedChanged="RadioButton_OnCheckedChanged"/>
        </VerticalStackLayout>

        <!-- CheckBoxes -->
        <VerticalStackLayout Grid.Row="0" Grid.Column="1">

            <HorizontalStackLayout>
                <CheckBox x:Name="Lemon" CheckedChanged="CHB_OnCheckedChanged"/>
                <Label Text="Lemon"/>
            </HorizontalStackLayout>

            <HorizontalStackLayout>
                <CheckBox x:Name="Orange" CheckedChanged="CHB_OnCheckedChanged"/>
                <Label Text="Orange"/>
            </HorizontalStackLayout>

            <HorizontalStackLayout>
                <CheckBox x:Name="Banana" CheckedChanged="CHB_OnCheckedChanged"/>
                <Label Text="Banana"/>
            </HorizontalStackLayout>

        </VerticalStackLayout>

        <!-- Labels -->
        <VerticalStackLayout Grid.Row="1" Grid.ColumnSpan="2">
            <Label x:Name="radio" Text="Radio status"/>
            <Label x:Name="chb" Text="Checkbox status"/>
        </VerticalStackLayout>

    </Grid>

</ContentPage>